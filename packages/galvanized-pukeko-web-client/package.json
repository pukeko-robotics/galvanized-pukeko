{
  "name": "@galvanized-pukeko/web-client",
  "version": "0.0.2",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "sink": "vite --open /sink/",
    "build": "pnpm run type-check && pnpm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "oxlint . --fix -D correctness --ignore-path .gitignore && eslint . --fix",
    "format": "prettier --write src/"
  },
  "author": "Andrew Kondratev",
  "license": "MIT",
  "private": true,
  "description": "Thin host app that mounts @galvanized-pukeko/vue-ui — the dev server and the build embedded by the ADK agent.",
  "dependencies": {
    "@copilotkit/vue": "^1.72.0",
    "@galvanized-pukeko/vue-ui": "workspace:*",
    "chart.js": "^4.5.1",
    "vue": "^3.5.42",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-plugin-oxlint": "^0.16.12",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^26.1.0",
    "oxlint": "^0.16.12",
    "prettier": "^3.9.7",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  }
}
