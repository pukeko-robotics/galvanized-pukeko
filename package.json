{
  "name": "galvanized-pukeko",
  "version": "0.0.1",
  "private": true,
  "description": "Give your LLM agent a real UI: a Vue 3 component library that renders forms, charts, tables and interactive A2UI surfaces over the AG-UI protocol, with reference AG-UI backends.",
  "author": "Andrew Kondratev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pukeko-robotics/galvanized-pukeko.git"
  },
  "homepage": "https://github.com/pukeko-robotics/galvanized-pukeko#readme",
  "bugs": "https://github.com/pukeko-robotics/galvanized-pukeko/issues",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "type-check": "tsc -p tsconfig.tooling.json",
    "build": "pnpm run type-check && pnpm -r run build",
    "lint": "oxlint --ignore-path .gitignore --ignore-pattern \"packages/galvanized-pukeko-agent-adk/src/main/resources/browser/**\" -D correctness .",
    "test": "node scripts/check-no-bare-launchers.mjs && node scripts/check-llm-config.mjs && node scripts/check-ollama-gpu-lock.mjs && node scripts/check-first-attempt-rate.mjs && node scripts/check-harness-argv.mjs && node scripts/check-vendored-bundle.mjs && node scripts/check-npm-release-age.mjs --offline && pnpm run lint && pnpm -r run test",
    "check:npm-release-age": "node scripts/check-npm-release-age.mjs",
    "web": "pnpm --filter @galvanized-pukeko/web-client run dev",
    "web-ag-ui": "AGUI_URL=http://localhost:3000/agents/default/run pnpm --filter @galvanized-pukeko/web-client run dev",
    "sink": "pnpm --filter @galvanized-pukeko/web-client run sink",
    "it-adk": "node it-adk.js",
    "it-adk-headed": "node it-adk.js --headed",
    "it-koog": "node it-koog.js",
    "it-koog-headed": "node it-koog.js --headed",
    "it-gth-ag-ui": "node it-gth-ag-ui.js",
    "start-adk": "node start-adk.js",
    "start-gth-ag-ui": "node start-gth-ag-ui.js",
    "vendor:adk": "pnpm --filter @galvanized-pukeko/web-client run deploy-to-adk",
    "release:bump": "node scripts/bump-vue-ui.mjs",
    "release:bump-and-commit": "node scripts/bump-vue-ui.mjs --commit"
  },
  "dependencies": {
    "@gaunt-sloth/agent": "2.0.0-beta.13",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/ws": "^8.18.1",
    "express": "^5.2.1",
    "vue": "^3.5.42",
    "ws": "^8.21.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-oxlint": "^0.16.12",
    "eslint-plugin-vue": "^10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "oxlint": "^0.16.12",
    "prettier": "^3.9.7",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  }
}
